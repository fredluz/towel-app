{
  "name": "towel-app",
  "version": "0.1.0",
  "description": "Voice-first workout runtime for Pi on macOS",
  "private": true,
  "type": "module",
  "bin": {
    "towel": "./bin/towel.mjs"
  },
  "pi": {
    "extensions": [
      "./.pi/extensions/towel/index.ts"
    ]
  },
  "scripts": {
    "build:voice": "swift build --package-path voice -c release",
    "test": "node --test tests/*.test.mjs",
    "test:voice": "swift test --package-path voice",
    "typecheck": "tsc --noEmit",
    "towel": "node ./bin/towel.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3"
  },
  "license": "MIT"
}
